<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Edit Enquiry</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>

<h2>Edit Enquiry</h2>
<form method="POST">
  <table style="border: none; width: 60%; margin: auto;">
    <tr><td>Date:</td><td><input type="date" name="Date" value="{{ record['Date'] }}"></td></tr>
    <tr><td>Name:</td><td><input name="Name" value="{{ record['Name'] }}"></td></tr>
    <tr><td>Mobile Number:</td><td><input name="Mobile" value="{{ record['Mobile'] }}"></td></tr>
    <tr><td>Mode:</td><td>
        <select name="Mode">
          {% for m in mode_options %}
            <option value="{{ m }}" {% if record['Mode'] == m %}selected{% endif %}>{{ m }}</option>
          {% endfor %}
        </select>
      </td></tr>
    <tr><td>Appointment Date:</td><td><input type="date" name="AppDate" value="{{ record['AppDate'] }}"></td></tr>
    <tr><td>Timing:</td>
      <td>
        <select name="Timing">
          {% for t in timing_options %}
            <option value="{{ t }}" {% if record['Timing'] == t %}selected{% endif %}>{{ t }}</option>
          {% endfor %}
        </select>
      </td></tr>
    <tr><td>Doctor:</td>
      <td>
        <select name="Doctor">
          {% for d in doctor_options %}
            <option value="{{ d }}" {% if record['Doctor'] == d %}selected{% endif %}>{{ d }}</option>
          {% endfor %}
        </select>
      </td></tr>
    <tr><td>Request For:</td><td><input name="RequestFor" value="{{ record['RequestFor'] }}"></td></tr>
    <tr><td>Comment:</td><td><input name="Comment" value="{{ record['Comment'] }}"></td></tr>
    <tr><td>Status:</td>
      <td>
        <select name="Status">
          {% for s in status_options %}
            <option value="{{ s }}" {% if record['Status'] == s %}selected{% endif %}>{{ s }}</option>
          {% endfor %}
        </select>
      </td></tr>
    <tr><td>Attended By:</td>
      <td>
        <select name="AttendedBy">
          {% for n in nurse_options %}
            <option value="{{ n }}" {% if record['Attendedby'] == n %}selected{% endif %}>{{ n }}</option>
          {% endfor %}
        </select>
      </td></tr>
    <tr><td>Handover To:</td><td><input name="HandoverTo" value="{{ record['HandoverTo'] }}"></td></tr>

    <tr>
      <td colspan="2" style="text-align: center;">
        <button type="submit" name="action" value="update">Update</button>
        <button type="submit" name="action" value="cancel">Cancel</button>
      </td>
    </tr>
  </table>
</form>

</body>
</html>
